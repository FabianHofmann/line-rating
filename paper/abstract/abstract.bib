	title = {{IEEE} Std 738™-2012 (Revision of {IEEE} Std 738-2006/Incorporates {IEEE} Std 738-2012/Cor 1-2013), {IEEE} Standard for Calculating the Current-Temperature Relationship of Bare Overhead Conductors},
