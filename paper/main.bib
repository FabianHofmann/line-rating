  author = {Gea-Bermúdez, Juan and Pade, Lise-Lotte and Koivisto, Matti Juhani and Ravn, Hans},
  date = {2020-01-15},
  journaltitle = {Energy},
  shortjournal = {Energy},
  volume = {191},
