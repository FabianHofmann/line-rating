@article{fernandezReviewDynamicLine2016,
  title = {Review of Dynamic Line Rating Systems for Wind Power Integration},
  author = {Fernandez, E. and Albizu, I. and Bedialauneta, M.T. and Mazon, A.J. and Leite, P.T.},
  year = {2016},
  month = jan,
  journal = {Renewable and Sustainable Energy Reviews},
  volume = {53},
  pages = {80--92},
  issn = {13640321},
  doi = {10.1016/j.rser.2015.07.149},
  abstract = {When a wind power system is connected to a network point there is a limit of power generation based on the characteristics of the network and the loads connected to it. Traditionally, transmission line limits are estimated conservatively assuming unfavourable weather conditions (high ambient temperature, full sun and low wind speed). However, the transmission capacity of an overhead line increases when wind speed is high, due to the cooling caused by wind in the distribution lines.},
  langid = {english}
