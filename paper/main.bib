@article{gusatuSpatialTemporalAnalysis2021,
  title = {Spatial and Temporal Analysis of Cumulative Environmental Effects of Offshore Wind Farms in the {{North Sea}} Basin},
  author = {Gușatu, Laura Florentina and Menegon, Stefano and Depellegrin, Daniel and Zuidema, Christian and Faaij, Andr{\'e} and Yamu, Claudia},
  year = {2021},
  month = may,
  journal = {Scientific Reports},
  volume = {11},
  number = {1},
  pages = {10125},
  publisher = {{Nature Publishing Group}},
  issn = {2045-2322},
  doi = {10.1038/s41598-021-89537-1},
  abstract = {The North Sea basin is one of the busiest maritime areas globally with a considerable number of anthropogenic pressures impacting the functioning of the marine ecosystem. Due to growing EU ambitions for the deployment of large offshore wind farm projects (OWF), as part of the 2050 renewable energy roadmap, there is a key need for a holistic understanding of OWF potential impacts on the marine ecosystem. We propose a holistic Cumulative Effect Assessment methodology, applied using a geo-spatial open-source software, to assess impacts of OWF related pressures on selected seabed habitats, fish, seabird and mammal species. We take into account pressures specific to the three OWF development phases, spanning 1999\textendash 2050, for the entire North Sea basin. Our results underline 2022 as the peak year of cumulative impacts for the approved OWFs, followed by a considerable increase in potential impacts of the planned 212GWs, by 2050. The spatio-temporal analysis of the OWF environmental impacts presents the shift between highly impacted areas over the studied timeline and distinguishes between concentrated areas of high impacts (S\textendash E of UK) and dispersed areas of high impacts (Germany). Our results can inform decision-makers and the OWF industry in a joint effort to mitigate the environmental impacts of future large OWF developments.},
  langid = {english},
  keywords = {Climate sciences,Ecology,Environmental social sciences,Ocean sciences}
}

